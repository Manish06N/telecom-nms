# Copy to .env and change SECRET_KEY before any shared deployment.
APP_NAME=Telecom NMS
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Leave blank unless Redis is running on this machine.
# Docker Compose sets redis://redis:6379/0 on its own.
REDIS_URL=
# Use sqlite:///./telecom.db if you do not have PostgreSQL installed.
DATABASE_URL=postgresql+psycopg://telecom:telecom@localhost:5432/telecom
AUTO_SEED=true
ADMIN_EMAIL=admin@telecom.local
ADMIN_PASSWORD=Admin@12345
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10
CORS_ORIGINS=*
TASK_BACKEND=background
DELIVER_NOTIFICATIONS=true
USAGE_ALERT_PERCENT=80
PLAN_EXPIRY_WARNING_DAYS=3
